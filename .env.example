# Local development only. NEVER commit a real API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model/settings overrides
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SCREEN_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_SCREEN_THINKING_LEVEL=minimal
GEMINI_MAX_OUTPUT_TOKENS=1800
SCREENING_WORKERS=2
SCREENING_DELAY_SECONDS=0.15

# Optional local/hosted storage overrides.
# Leave blank to use ./data/recruiting_workbench.db
# DATA_DIR=./data
# DATABASE_PATH=./data/recruiting_workbench.db

# Safety default: no real email is sent.
EMAIL_DELIVERY_MODE=mock
